# | Register | Usage     | Type    | Description                |
# | -------- | --------- | ------- | -------------------------- |
# | `$a0`    | input     | integer | input number               |
# | `$v0`    | output    | integer | number of eggs             |
# | `$t0-9`  | temporary | any     | used for temporary storage |

.globl egg_count

egg_count:
  addi $v0, $zero, 0
loop:  
  beq $a0, $zero, exit
  andi $t0, $a0, 0x1
  add $v0, $v0, $t0
  srl $a0, $a0, 1
  b loop
exit:
  jr $ra
